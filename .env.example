# Frontend — expose only these values to the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend — keep these values server-side and never commit them
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
FRONTEND_ORIGIN=http://localhost:3000
MAX_REFERENCE_FILE_MB=10
MAX_PHOTO_FILE_MB=8
MAX_PHOTOS_PER_EVENT=20

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
